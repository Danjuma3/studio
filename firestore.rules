rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Kitchen Profit Professional Security Rules
     * Optimized for Global Launch
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'chefdtanju@gmail.com';
    }

    // --- System Rules (Publicly Readable for Branding) ---
    // Specifically separated to ensure public access to branding and alerts
    match /system/payment {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system/alert {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- User Data Partitioning ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      match /ingredients/{ingredientId} {
        allow read, write: if isOwner(userId);
      }

      match /recipes/{recipeId} {
        allow read, write: if isOwner(userId);
      }

      match /staff/{staffId} {
        allow read, write: if isOwner(userId);
      }
      
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }
      
      match /issues/{issueId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}