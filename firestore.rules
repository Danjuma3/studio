
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Kitchen Prof Security Rules
     *
     * ADMIN POLICY:
     * chefdtanju@gmail.com is granted global administrative access.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true || 
        request.auth.token.email == "chefdtanju@gmail.com"
      );
    }

    function isOwner(userId) {
      return isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Global System Config: Everyone can read, only Admin can write
    match /system/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
