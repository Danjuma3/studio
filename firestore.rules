rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * EkoPlateCost Security Rules
     *
     * CORE PHILOSOPHY
     * This ruleset enforces a strict Path-Based Ownership model. All data is partitioned
     * by the user's unique identifier (UID) to ensure absolute privacy and security. 
     * Access is granted exclusively to the authenticated owner of the data tree.
     *
     * DATA STRUCTURE
     * The database is organized hierarchically under a root /users/{userId} path:
     * - /users/{userId}/ingredients: User's private inventory and pricing.
     * - /users/{userId}/recipes: User's private culinary formulas.
     * - Subcollections (RecipeIngredients, MarketPriceLogs) are nested to maintain 
     *   the authorization context of the parent user.
     *
     * KEY SECURITY DECISIONS
     * 1. Path-Based Authorization: By embedding the userId in the path, we achieve 
     *    "Authorization Independence." Rules compare request.auth.uid directly to the 
     *    path variable, avoiding expensive get() lookups.
     * 2. Strict Privacy: There is no public or shared data. All collections require 
     *    authentication and ownership for any read or write operation.
     * 3. Relational Integrity: On creation, we enforce that internal 'id' and 'foreignKey' 
     *    fields match the path variables to prevent data drift.
     * 4. Prototyping Flexibility: While authorization is strictly enforced, the rules 
     *    do not validate the specific data types or presence of non-relational fields 
     *    (e.g., name, description) to allow for rapid schema iteration.
     */

    // --- Helper Functions ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user matches the owner of the path. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the user is the owner and the document exists (for updates/deletes). */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // --- Rules ---

    /**
     * @description Rules for the top-level user folder. 
     * Note: This usually handles the user profile document itself.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users cannot be listed.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if false; // User deletion usually handled via Admin SDK/Auth triggers.
    }

    /**
     * @description Manages individual ingredients in a user's inventory.
     * @path /users/{userId}/ingredients/{ingredientId}
     * @allow Authenticated user 'abc' creating an ingredient at /users/abc/ingredients/ing_123 (create)
     * @deny Authenticated user 'xyz' trying to list ingredients at /users/abc/ingredients (list)
     * @principle Path-based ownership and relational integrity (id validation).
     */
    match /users/{userId}/ingredients/{ingredientId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == ingredientId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Historical price tracking for a specific ingredient.
       * @path /users/{userId}/ingredients/{ingredientId}/marketPriceLogs/{logId}
       * @allow User 'abc' adding a price log to their own ingredient (create)
       * @principle Nested authorization inheriting ownership from the parent user path.
       */
      match /marketPriceLogs/{logId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.id == logId && request.resource.data.ingredientId == ingredientId;
        allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
        allow delete: if isExistingOwner(userId);
      }
    }

    /**
     * @description Manages recipes created by the user.
     * @path /users/{userId}/recipes/{recipeId}
     * @allow User 'abc' updating their own recipe 'recipe_1' (update)
     * @deny User 'abc' attempting to read user 'xyz's recipe (get)
     * @principle Private Data via Path-Based ownership.
     */
    match /users/{userId}/recipes/{recipeId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == recipeId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Links ingredients to a specific recipe.
       * @path /users/{userId}/recipes/{recipeId}/recipeIngredients/{riId}
       * @allow User 'abc' listing ingredients for their own recipe (list)
       * @principle Strict structural segregation of user recipe data.
       */
      match /recipeIngredients/{riId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.id == riId && request.resource.data.recipeId == recipeId;
        allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
        allow delete: if isExistingOwner(userId);
      }
    }
  }
}

/**
 * Analysis Summary (Step 1):
 * 1. Intent: The system follows a strict "EkoPlateCost" restaurant-specific ownership model.
 * 2. Access Patterns: All collections follow the "Ownership" pattern (P3.1) and "Self-Creation" for the root (P3.4).
 * 3. Relational Integrity: Critical checks are included to ensure 'id' and 'foreignKey' fields match their 
 *    Firestore path counterparts, preventing data being "orphaned" or misattributed.
 * 4. Flexible Schema: Rules allow any data shape for ingredient/recipe properties (name, description, etc.) 
 *    to support prototyping.
 */

// Deployment Guide:
// 1. Ensure you have the Firebase CLI installed (`npm install -g firebase-tools`).
// 2. Run `firebase init firestore` in your project root if not already initialized.
// 3. Paste this code into your `firestore.rules` file.
// 4. Deploy using `firebase deploy --only firestore:rules`.