{
  "entities": {
    "Ingredient": {
      "title": "Ingredient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "unitOfMeasure": { "type": "string" },
        "bulkUnitPrice": { "type": "number" },
        "retailUnitPrice": { "type": "number" },
        "weeklyUsage": { "type": "number" },
        "currentStock": { "type": "number" },
        "minStock": { "type": "number" }
      }
    },
    "Recipe": {
      "title": "Recipe",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sellingPrice": { "type": "number" },
        "items": { "type": "array" }
      }
    },
    "SystemPaymentConfig": {
      "title": "SystemPaymentConfig",
      "type": "object",
      "properties": {
        "bankName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "accountName": { "type": "string" },
        "paystackPublicKey": { "type": "string" },
        "proPrice": { "type": "number" },
        "proPriceUSD": { "type": "number" },
        "appLogoUrl": { "type": "string" }
      }
    },
    "SystemAlert": {
      "title": "SystemAlert",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "type": { "type": "string" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/system/payment": {
      "schema": { "$ref": "#/backend/entities/SystemPaymentConfig" },
      "description": "Global payment and branding configuration."
    },
    "/system/alert": {
      "schema": { "$ref": "#/backend/entities/SystemAlert" },
      "description": "Global broadcast messages."
    },
    "/users/{userId}/ingredients/{ingredientId}": {
      "schema": { "$ref": "#/backend/entities/Ingredient" },
      "description": "User's private ingredient inventory."
    },
    "/users/{userId}/recipes/{recipeId}": {
      "schema": { "$ref": "#/backend/entities/Recipe" },
      "description": "User's private recipe configurations."
    }
  }
}