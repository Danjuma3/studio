
{
  "entities": {
    "Ingredient": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Ingredient",
      "type": "object",
      "description": "Represents a single raw food item or component used in recipes, storing its core pricing and measurement information.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Ingredient entity."
        },
        "name": {
          "type": "string",
          "description": "The common name of the ingredient (e.g., 'Tomato', 'Flour')."
        },
        "description": {
          "type": "string",
          "description": "A detailed description or additional notes about the ingredient."
        },
        "unitOfMeasure": {
          "type": "string",
          "description": "The standard unit of measure for this ingredient (e.g., 'kg', 'liter', 'piece', 'g', 'bag', 'crate', 'bucket')."
        },
        "bulkUnitPrice": {
          "type": "number",
          "description": "The price per unit of measure when the ingredient is purchased in bulk."
        },
        "retailUnitPrice": {
          "type": "number",
          "description": "The price per unit of measure when the ingredient is purchased at retail."
        },
        "currentStock": {
          "type": "number",
          "description": "Current quantity in the pantry."
        },
        "minStock": {
          "type": "number",
          "description": "Threshold for low stock alerts."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the ingredient record was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp indicating when the ingredient record was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "unitOfMeasure",
        "bulkUnitPrice",
        "retailUnitPrice",
        "createdAt",
        "updatedAt"
      ]
    },
    "Recipe": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Recipe",
      "type": "object",
      "description": "Defines a complete recipe, including its name and a collection of ingredients with specified quantities.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Recipe entity."
        },
        "name": {
          "type": "string",
          "description": "The name of the recipe (e.g., 'Jollof Rice', 'Efo Riro')."
        },
        "description": {
          "type": "string",
          "description": "A detailed description or instructions for the recipe."
        },
        "sellingPrice": {
          "type": "number",
          "description": "The intended price for the finished dish."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the recipe record was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp indicating when the recipe record was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "createdAt",
        "updatedAt"
      ]
    },
    "StaffMember": {
      "title": "StaffMember",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["Chef", "Server", "Cleaner", "Sous Chef"] },
        "status": { "type": "string", "enum": ["active", "on-break", "off-duty"] }
      }
    },
    "ManagerTask": {
      "title": "ManagerTask",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "task": { "type": "string" },
        "completed": { "type": "boolean" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] }
      }
    },
    "SystemPaymentConfig": {
      "title": "SystemPaymentConfig",
      "type": "object",
      "properties": {
        "bankName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "accountName": { "type": "string" },
        "paystackPublicKey": { "type": "string" },
        "proPrice": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ],
    "customClaims": {
      "admin": {
        "type": "boolean",
        "description": "Grants global read/write access to all kitchen prof data."
      }
    }
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}/ingredients/{ingredientId}",
        "definition": {
          "entityName": "Ingredient",
          "schema": {
            "$ref": "#/backend/entities/Ingredient"
          },
          "description": "User-specific ingredient data."
        }
      },
      {
        "path": "/users/{userId}/recipes/{recipeId}",
        "definition": {
          "entityName": "Recipe",
          "schema": {
            "$ref": "#/backend/entities/Recipe"
          },
          "description": "User-specific recipe data."
        }
      },
      {
        "path": "/users/{userId}/staff/{staffId}",
        "definition": {
          "entityName": "StaffMember",
          "schema": {
            "$ref": "#/backend/entities/StaffMember"
          },
          "description": "User-specific staff management data."
        }
      },
      {
        "path": "/users/{userId}/tasks/{taskId}",
        "definition": {
          "entityName": "ManagerTask",
          "schema": {
            "$ref": "#/backend/entities/ManagerTask"
          },
          "description": "User-specific operational tasks."
        }
      },
      {
        "path": "/system/payment",
        "definition": {
          "entityName": "SystemPaymentConfig",
          "schema": {
            "$ref": "#/backend/entities/SystemPaymentConfig"
          },
          "description": "Global platform payment settings."
        }
      }
    ]
  }
}
